{
  "expo": {
    "name": "Mavvy",
    "slug": "mavvy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leoudev.mavvy",
      "appleTeamId": "Z5643XKUTZ",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6E0D6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.leoudev.mavvy"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mavvy uses your photo library so you can add pictures of your car and its mods.",
          "cameraPermission": "Mavvy uses your camera so you can take pictures of your car and its mods.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#E6E0D6",
          "dark": {
            "image": "./assets/icon.png",
            "backgroundColor": "#E6E0D6"
          }
        }
      ]
    ],
    "scheme": "mavvy",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "b45728db-d75e-4fac-b286-897300442903"
      }
    },
    "owner": "galileouuu"
  }
}
